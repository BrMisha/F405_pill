	(text "NC\nGND\nV3V3\nADC SPI1SCK DAC TIM2\nADC SPI1MISO TIM3\nJP3 / FET TEMP\nA_PHC_VSENSE\nJP2 / MOTOR TEMP / SPI1MOSI\nA_PHB_VSENSE\nA_PHA_VSENSE\nA_SHC_AMP\nA_SHB_AMP\nA_SHA_AMP\nVSENSE\nA_THROTTLE\nJP3 / FET TEMP\nHALL_C\nHALL_B\nHALL_A\nNC"
		(exclude_from_sim no)
		(at 367.03 75.692 0)
		(effects
